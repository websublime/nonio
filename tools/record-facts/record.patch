+
+// nonio: record every extraction, keyed by path and content hash, with spans as UTF-8 byte offsets.
+function recordFacts(dir: string, path: string, source: string, facts: FileFacts) {
+  const bytes = (off: number) => Buffer.byteLength(source.slice(0, off), 'utf8');
+  const hash = crypto.createHash('sha256').update(source, 'utf8').digest('hex');
+  const out = { ...facts, symbols: facts.symbols.map((s) => ({ ...s, span: { start: bytes(s.span.start), end: bytes(s.span.end) } })) };
+  fs.mkdirSync(dir, { recursive: true });
+  const file = `${dir}/${hash}-${path.replace(/[^A-Za-z0-9._-]/g, '_')}.json`;
+  const body = JSON.stringify({ path, sha256: hash, facts: out });
+  if (fs.existsSync(file) && fs.readFileSync(file, 'utf8') !== body) fs.writeFileSync(`${file}.conflict`, body);
+  fs.writeFileSync(`${dir}/${hash}-${path.replace(/[^A-Za-z0-9._-]/g, '_')}.json`, JSON.stringify({ path, sha256: hash, facts: out }));
+}
